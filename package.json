{
  "name": "vcard-local-service",
  "version": "1.0.0",
  "private": true,
  "description": "本地 vCard 4.0 联系人导入导出与多值字段服务（仅 API 与 CLI）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "node --experimental-sqlite src/server.ts",
    "cli": "node --experimental-sqlite dist/cli.js",
    "test": "node --experimental-sqlite --import tsx/esm --test \"test/*.test.ts\"",
    "demo": "node --experimental-sqlite demo/run-demo.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  }
}
